#!/usr/bin/env bash
# Fork checks that fit the Stop-hook budget on this machine:
#   1. scripts/check-telemetry: no hard-coded upstream tracking id or telemetry
#      destination (a few seconds);
#   2. Biome lint of the whole web app (about 7 s).
# Not run here:
#   - `bun run check` (tsc --noEmit on apps/web) aborts with SIGABRT (out of memory, 2026-11-12);
#   - the Rust workspace test suite and the vitest suite each need far more than 5 minutes.
set -uo pipefail
cd "$(dirname "$0")/.."

status=0

nice -n 10 scripts/check-telemetry || status=1
nice -n 10 bun run lint || status=1

exit "$status"
