#!/usr/bin/env bash
# Start, stop and keep one long-lived local stack (a self-hosted instance).
#
#   engine start    bring the instance up over its existing volumes, then put
#                   back the LocalStack objects saved by `backup`
#   engine stop     save LocalStack objects, then stop the containers (data kept)
#   engine backup   save new and changed LocalStack objects
#   engine status   the stack's status as JSON
#
# Settings come from $ENGINE_HOME/engine.env (default ~/macro-instance), which
# sets ENGINE_INSTANCE, ENGINE_PORT_BASE and the MACRO_LOCAL_* variables. The
# start command is the only one this script uses: detached, so it never wipes;
# an attached `just run_local`, `just stack up` or `--fresh` would.
set -euo pipefail

ENGINE_HOME="${ENGINE_HOME:-$HOME/macro-instance}"
ENGINE_CHECKOUT="${ENGINE_CHECKOUT:-$HOME/macro-work/macro}"
# shellcheck source=/dev/null
. "$ENGINE_HOME/engine.env"
: "${ENGINE_INSTANCE:?set ENGINE_INSTANCE in engine.env}"
: "${ENGINE_PORT_BASE:?set ENGINE_PORT_BASE in engine.env}"

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
storage_dir="$ENGINE_HOME/storage"
nix_profile=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
if [[ -f "$nix_profile" ]]; then
  # shellcheck source=/dev/null
  . "$nix_profile"
fi

in_shell() {
  (cd "$ENGINE_CHECKOUT" && nix develop --command "$@")
}

# A set from fetch-engine: prebuilt service programs, start tool and web app,
# so nothing is compiled here. Without one, `just run_local` builds them.
prebuilt="$ENGINE_HOME/prebuilt/current"

run_local() {
  if [[ -x "$prebuilt/bin/xtask_local" ]]; then
    MACRO_LOCAL_STATIC_BUNDLE="$prebuilt/frontend" \
      in_shell "$prebuilt/bin/xtask_local" run-local "$@" --instance "$ENGINE_INSTANCE"
  else
    in_shell just run_local "$@" --instance "$ENGINE_INSTANCE"
  fi
}

# The binaries dir flag, when a prebuilt set is installed.
binaries_args() {
  if [[ -x "$prebuilt/bin/xtask_local" ]]; then
    echo "--binaries-dir"
    echo "$prebuilt/bin"
  fi
}

# The set only matches the checkout it was built from (compose image tags and
# the web app are keyed on the repository's content).
check_prebuilt_commit() {
  [[ -f "$prebuilt/build.json" ]] || return 0
  local built head
  built="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["commit"])' "$prebuilt/build.json")"
  head="$(git -C "$ENGINE_CHECKOUT" rev-parse HEAD)"
  if [[ "$built" != "$head" ]]; then
    echo "engine: the prebuilt set is from $built but the checkout is at $head;" >&2
    echo "engine: check out $built or run fetch-engine for a newer set" >&2
    return 1
  fi
}

# The running LocalStack container of this instance and its network.
localstack_container() {
  docker ps --quiet \
    --filter "label=com.docker.compose.service=localstack" \
    --filter "label=com.docker.compose.project=$(compose_project)" | head -n 1
}

compose_project() {
  run_local status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["project"])'
}

storage() {
  local action="$1" container network image
  container="$(localstack_container)"
  if [[ -z "$container" ]]; then
    echo "engine: LocalStack is not running" >&2
    return 1
  fi
  network="$(docker inspect "$container" \
    --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{"\n"}}{{end}}' | head -n 1)"
  image="$(docker inspect "$container" --format '{{.Config.Image}}')"
  mkdir -p "$storage_dir"
  docker run --rm --network "$network" \
    --volume "$storage_dir:/storage" \
    --volume "$self_dir/storage.py:/storage.py:ro" \
    --entrypoint /opt/code/localstack/.venv/bin/python \
    "$image" /storage.py "$action" /storage
}

case "${1:-}" in
  start)
    check_prebuilt_commit
    mapfile -t prebuilt_args < <(binaries_args)
    run_local --detach --no-doppler --env-file "$ENGINE_HOME/local.env" \
      --port-base "$ENGINE_PORT_BASE" --static-frontend --traces off --no-computers \
      "${prebuilt_args[@]}"
    storage restore
    ;;
  stop)
    storage backup || echo "engine: backup skipped" >&2
    run_local stop
    ;;
  backup)
    storage backup
    ;;
  status)
    run_local status --json
    ;;
  *)
    echo "usage: engine start|stop|backup|status" >&2
    exit 2
    ;;
esac
