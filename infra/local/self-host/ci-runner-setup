#!/usr/bin/env bash
# Prepare a free GitHub-hosted Ubuntu runner for the fork's builds.
#
#   ci-runner-setup disk   remove preinstalled toolchains the builds never use
#   ci-runner-setup nix    install Nix (official installer, multi-user) with
#                          /nix on the runner's larger disk
#
# Used by .github/workflows/fork-desktop.yml and fork-engine.yml only.
set -euo pipefail

NIX_VERSION=2.35.6

show_space() {
  df -h / /mnt 2>/dev/null || df -h /
  nproc
  free -g
}

# The biggest preinstalled trees on ubuntu-24.04 images that no build here reads.
free_disk() {
  show_space
  sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /usr/local/.ghcup \
    /opt/hostedtoolcache/CodeQL /usr/share/swift /usr/local/share/powershell \
    /usr/local/share/chromium /usr/lib/jvm /opt/microsoft /opt/google
  sudo docker image prune --all --force >/dev/null 2>&1 || true
  show_space
}

# Put a path on the bigger of / and /mnt: bind-mount a /mnt directory over it.
on_big_disk() {
  local path="$1" root_free mnt_free
  root_free="$(df --output=avail -B1 / | tail -n 1)"
  mnt_free="$(df --output=avail -B1 /mnt 2>/dev/null | tail -n 1 || echo 0)"
  sudo mkdir -p "$path"
  if [[ "${mnt_free:-0}" -gt "$root_free" ]]; then
    sudo mkdir -p "/mnt/big$path"
    sudo mount --bind "/mnt/big$path" "$path"
    echo "$path is on /mnt"
  fi
  sudo chown "$(id -u):$(id -g)" "$path" || true
}

install_nix() {
  on_big_disk /nix
  sudo chown root:root /nix
  curl --proto '=https' --tlsv1.2 -sSfL --retry 5 \
    "https://releases.nixos.org/nix/nix-$NIX_VERSION/install" -o "$RUNNER_TEMP/nix-install"
  cat >"$RUNNER_TEMP/nix-extra.conf" <<EOF
experimental-features = nix-command flakes
trusted-users = root $(id -un)
max-jobs = auto
cores = 0
download-attempts = 10
EOF
  sh "$RUNNER_TEMP/nix-install" --daemon --yes --no-channel-add \
    --nix-extra-conf-file "$RUNNER_TEMP/nix-extra.conf" </dev/null
  echo "/nix/var/nix/profiles/default/bin" >>"$GITHUB_PATH"
  /nix/var/nix/profiles/default/bin/nix --version
}

case "${1:-}" in
  disk) free_disk ;;
  nix) install_nix ;;
  big-dir) on_big_disk "${2:?usage: ci-runner-setup big-dir <path>}" ;;
  *)
    echo "usage: ci-runner-setup disk | nix | big-dir <path>" >&2
    exit 2
    ;;
esac
